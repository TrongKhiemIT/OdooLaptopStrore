<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laptop_product_tree" model="ir.ui.view">
        <field name="name">laptop.product.tree</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <tree string="Danh sách laptop">
                <field name="name" />
                <field name="brand" />
                <field name="price" />
                <field name="stock_qty" />
            </tree>
        </field>
    </record>

    <record id="view_laptop_product_form" model="ir.ui.view">
        <field name="name">laptop.product.form</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <form string="Laptop">
                <group>
                    <field name="name" />
                    <field name="brand" />
                    <field name="price" />
                    <field name="stock_qty" />
                    <field name="description" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_laptop_product_search" model="ir.ui.view">
        <field name="name">laptop.product.search</field>
        <field name="model">laptop.product</field>
        <field name="arch" type="xml">
            <search string="Tìm laptop">
                <field name="name" />
                <field name="brand" />
            </search>
        </field>
    </record>

    <record id="action_laptop_product" model="ir.actions.act_window">
        <field name="name">Laptops</field>
        <field name="res_model">laptop.product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_laptop_store_root" name="Laptop Store" sequence="10" />
    <menuitem id="menu_laptop_product" name="Laptops"
        parent="menu_laptop_store_root" action="action_laptop_product" />
</odoo>