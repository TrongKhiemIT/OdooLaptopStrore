<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laptop_sale_order_tree" model="ir.ui.view">
        <field name="name">laptop.sale.order.tree</field>
        <field name="model">laptop.sale.order</field>
        <field name="arch" type="xml">
            <tree string="Danh sách đơn bán">
                <field name="name" />
                <field name="customer_id" />
                <field name="date" />
                <field name="state" />
                <field name="total" />
            </tree>
        </field>
    </record>

    <record id="view_laptop_sale_order_form" model="ir.ui.view">
        <field name="name">laptop.sale.order.form</field>
        <field name="model">laptop.sale.order</field>
        <field name="arch" type="xml">
            <form string="Đơn bán">
                <group>
                    <field name="name" />
                    <field name="customer_id" />
                    <field name="date" />
                    <field name="state" />
                </group>
                <field name="line_ids">
                    <tree string="Chi tiết đơn">
                        <field name="product_id" />
                        <field name="qty" />
                        <field name="unit_price" />
                        <field name="subtotal" />
                    </tree>
                </field>
            </form>
        </field>
    </record>

    <record id="view_laptop_sale_order_search" model="ir.ui.view">
        <field name="name">laptop.sale.order.search</field>
        <field name="model">laptop.sale.order</field>
        <field name="arch" type="xml">
            <search string="Tìm đơn bán">
                <field name="name" />
                <field name="customer_id" />
            </search>
        </field>
    </record>

    <record id="action_laptop_sale_order" model="ir.actions.act_window">
        <field name="name">Đơn bán</field>
        <field name="res_model">laptop.sale.order</field>
        <field name="view_mode">tree,form</field>
    </record>


    <menuitem id="menu_laptop_sale_order" name="Đơn bán"
        parent="menu_laptop_store_root" action="action_laptop_sale_order" />

</odoo>