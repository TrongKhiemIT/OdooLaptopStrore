<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_laptop_stock_receipt_tree" model="ir.ui.view">
        <field name="name">laptop.stock.receipt.tree</field>
        <field name="model">laptop.stock.receipt</field>
        <field name="arch" type="xml">
            <tree string="Danh sách đơn nhập">
                <field name="name" />
                <field name="date" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <record id="laptop_stock_receipt_view_form" model="ir.ui.view">
        <field name="name">laptop.stock.rece.view.form</field>
        <field name="model">laptop.stock.receipt</field>
        <field name="arch" type="xml">
            <form string="Đơn nhập">
                <header>
                    <button string="Xác nhận" name="action_confirm" type="object"
                        class="btn-primary" invisible="state != 'draft'" />
                    <button string="Hủy" name="action_cancel" type="object" class="btn-primary"
                        invisible="state != 'done'" />

                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="date" />
                        <field name="state" />
                    </group>
                    <field name="line_ids" string="Chi tiết đơn">
                        <tree>
                            <field name="product_id" />
                            <field name="qty" />
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="laptop_stock_receipt_view_search" model="ir.ui.view">
        <field name="name">laptop.stock.receipt.view.search</field>
        <field name="model">laptop.stock.receipt</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm đơn nhập">
                <field name="name" />
                <field name="date" />
            </search>
        </field>
    </record>

    <record id="laptop_stock_receipt_action" model="ir.actions.act_window">
        <field name="name">Đơn nhập</field>
        <field name="res_model">laptop.stock.receipt</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_laptop_stock_receipt" name="Nhậo kho"
        parent="menu_laptop_store_root" action="laptop_stock_receipt_action" />

</odoo>